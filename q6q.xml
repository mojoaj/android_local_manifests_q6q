-->
<manifest>
  <remote name="q6q" fetch="https://github.com/mojoaj" revision="refs/heads/q6q-24.0" />

  <!-- LineageOS repos carrying q6q patches (forks, branch q6q-24.0) -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="q6q" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <remove-project name="LineageOS/android_lineage-sdk" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="q6q" />
  <remove-project path="device/qcom/sepolicy_vndr/sm8650" name="LineageOS/android_device_qcom_sepolicy_vndr" />
  <project path="device/qcom/sepolicy_vndr/sm8650" name="android_device_qcom_sepolicy_vndr" remote="q6q" groups="qcom,lanai-vendor" />
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="q6q" groups="pdk" />
  <remove-project name="LineageOS/android_packages_inputmethods_LatinIME" />
  <project path="packages/inputmethods/LatinIME" name="android_packages_inputmethods_LatinIME" remote="q6q" groups="pdk-fs" />

  <!-- Device -->
  <project path="device/samsung/q6q" name="android_device_samsung_q6q" remote="q6q" />
  <project path="vendor/samsung/q6q" name="proprietary_vendor_samsung_q6q" remote="q6q" />

  <!-- Platform (forks of Exynoobs lineage-24.0 sm8650 trees, branch q6q-24.0) -->
  <project path="device/samsung/sm8650-common" name="android_device_samsung_sm8650-common" remote="q6q" />
  <project path="vendor/samsung/sm8650-common" name="proprietary_vendor_samsung_sm8650-common" remote="q6q" clone-depth="1" />
  <project path="hardware/samsung" name="android_hardware_samsung" remote="q6q" />
  <project path="device/samsung_slsi/sepolicy" name="LineageOS/android_device_samsung_slsi_sepolicy" remote="github" />

  <!-- Kernel -->
  <project path="kernel/samsung/sm8650" name="android_kernel_samsung_sm8650" remote="q6q" clone-depth="1" />
  <project path="kernel/samsung/sm8650-modules" name="android_kernel_samsung_sm8650-modules" remote="q6q" clone-depth="1" />
  <project path="kernel/samsung/sm8650-devicetrees" name="android_kernel_samsung_sm8650-devicetrees" remote="q6q" clone-depth="1" />
</manifest>
